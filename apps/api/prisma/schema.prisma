// RoomMate PRD v5.5 통합본 기준 스키마
// PostgreSQL / Strict ACID 트랜잭션 레이어

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id           String   @id @default(cuid())
  name         String
  district     String // 구 (예: 강남구) — 검색 필터 및 기존 region 대체
  neighborhood String? // 동 (예: 역삼동) — 구/동 단위 필터용, 지오코딩 전까지 널 허용
  address      String? // 전체 도로명 주소, 지오코딩 전까지 널 허용
  latitude     Float? // 위치 기반 추천(거리순 정렬)을 위한 좌표 — 실제 지도 API로 지오코딩 후 채움
  longitude    Float?
  naverBookingUrl String? // 네이버 예약 페이지 — 있으면 예약 버튼이 이걸 최우선으로 사용
  homepageUrl     String? // 매장 자체 홈페이지/예약 페이지 — naverBookingUrl이 없을 때 대체
  themes       Theme[]
  createdAt    DateTime @default(now())
}

model Theme {
  id                   String               @id @default(cuid())
  storeId              String
  store                Store                @relation(fields: [storeId], references: [id])
  name                 String
  genre                GenreTag // 유저 가입 선호도와 동일한 6분류 체계 (한국 방탈출 어워즈 기준)
  generation           GenerationPreference // 1/2/3세대 — 유저 선호 세대와 매칭
  difficulty           Int                  @default(3) // 체감 난이도 1~5
  pricePerPersonWon    Int // 1인 기준 정가
  capacityMin          Int
  capacityMax          Int
  recommendedHeadcount Int? // 최적(추천) 인원 — 처음엔 크롤링/공식 정원 기준, 이후 리뷰 투표로 갱신
  recommendedReason    String?
  openedAt             DateTime? // 오픈일 — "신상 테마" 필터를 오픈일 기준으로 동적 계산하기 위함
  rating               Float                @default(0)
  tags                 String[] // 매장 기본 특성 태그 (VARCHAR[] 원자적 컬럼)
  reviews              ThemeReview[]
  historyLogs          UserHistoryLog[]
  parties              Party[]
  themeStatWeight      ThemeStatWeight?
  createdAt            DateTime             @default(now())
}

// 실시간 게이미피케이션 스탯 스케일 연산 로직 (사양 #4)의 theme_stat_weights 테이블
model ThemeStatWeight {
  themeId String @id
  theme   Theme  @relation(fields: [themeId], references: [id])
  logic   Float  @default(0)
  observe Float  @default(0)
  speed   Float  @default(0)
  story   Float  @default(0)
  solving Float  @default(0)
  tank    Float  @default(0)
}

enum SocialProvider {
  KAKAO
  NAVER
  GOOGLE
}

// 가입 시 선호도 설문 (사양: 방린이면 종료, 아니면 장르/진행스타일/선호세대 + 공포 선택 시 역할까지)
// 장르는 한국 방탈출 어워즈 시상 부문 기준 6개 분류를 그대로 채택한다.
enum GenreTag {
  HORROR_THRILLER // 공포/스릴러
  EMOTIONAL_ROMANCE // 감성/드라마/로맨스
  MYSTERY_DETECTIVE // 추리/미스터리
  ACTION_ADVENTURE // 액션/어드벤처
  SCIFI_FANTASY // SF/판타지
  COMEDY_ETC // 코믹/문제/기타
}

enum PacingPreference {
  STORY // 스토리위주
  SPEED // 문제빨리풀기위주
}

// 방탈출 세대 구분 (1세대: 자물쇠·퀴즈 위주 / 2세대: 스토리+장치·센서 위주 /
// 3세대: 이머시브 연기연출·앱 연동·대형 자본). 기존의 "문제방/장치방 선호"와
// "이머시브 장르"를 하나의 축으로 통합한 것이다.
enum GenerationPreference {
  GEN1
  GEN2
  GEN3
}

enum HorrorRole {
  SCARED // 쫄
  PUSH_THROUGH // 전진쫄
  TANK // 탱커
}

// 방린이가 아닌 경우 누적 클리어 방수 구간. "경험 있음"만으로는 방 1개를 해본
// 사람과 100개 넘게 해본 헤비 유저를 구분할 수 없어 별도로 받는다.
enum ExperienceTier {
  TIER_10 // ~10방
  TIER_50 // ~50방
  TIER_100 // ~100방
  TIER_100_PLUS // 100방 이상
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String? // 소셜 로그인 전용 계정은 비밀번호가 없다
  provider             SocialProvider?
  providerId           String?
  nickname             String                @unique
  mannerTemp           Float                 @default(36.5)
  level                Int                   @default(1)
  totalClears          Int                   @default(0)
  currentExp           Float                 @default(0)
  isBeginner           Boolean               @default(false)
  experienceTier       ExperienceTier? // 방린이가 아닐 때만 채워짐 (누적 클리어 방수 구간)
  genrePreferences     GenreTag[]            @default([])
  pacingPreference     PacingPreference?
  generationPreference GenerationPreference?
  horrorRole           HorrorRole?
  stat                 UserStat?
  historyLogs          UserHistoryLog[]
  reviews              ThemeReview[]
  partyEntries         PartyParticipant[]
  createdAt            DateTime              @default(now())

  @@unique([provider, providerId])
}

// [도메인 2] Live_Hexagon_Radar_Chart 스탯 (theme_stat_weights 매핑 결과 누적치)
model UserStat {
  userId  String @id
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  logic   Float  @default(50)
  observe Float  @default(50)
  speed   Float  @default(50)
  story   Float  @default(50)
  solving Float  @default(50)
  tank    Float  @default(50)
}

enum HistoryStatus {
  PENDING_REVIEW
  REVIEWED
  MANUAL_ENTRY
}

// [도메인 2] Webhook 기반 자동 일지 적재 (user_history_logs 테이블)
model UserHistoryLog {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId   String
  theme     Theme         @relation(fields: [themeId], references: [id])
  playedAt  DateTime
  status    HistoryStatus @default(PENDING_REVIEW)
  partyId   String?
  createdAt DateTime      @default(now())
}

// [도메인 3] themes_reviews — 하이브리드형 간편 리뷰
model ThemeReview {
  id             String   @id @default(cuid())
  themeId        String
  theme          Theme    @relation(fields: [themeId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade          String // 풀길 | 흙길 | 인생테마 | 꽃길
  selectedTags   String[] // VARCHAR[] + GIN 인덱스 대상 컬럼
  votedHeadcount Int // 실체감 플레이 인원수 매칭 투표
  cleared        Boolean
  remainingSec   Int
  hintsUsed      Int
  comment        String?
  createdAt      DateTime @default(now())

  @@index([selectedTags], type: Gin)
}

enum PartyStatus {
  OPEN
  FILLED
  SETTLED
  DISPUTED
}

// [도메인 4] 안전 에스크로 기반 동행 매칭
model Party {
  id                String             @id @default(cuid())
  themeId           String
  theme             Theme              @relation(fields: [themeId], references: [id])
  hostUserId        String
  reservedAt        DateTime
  capacity          Int
  totalPriceWon     Int
  status            PartyStatus        @default(OPEN)
  verifiedBookingOk Boolean            @default(false)
  participants      PartyParticipant[]
  createdAt         DateTime           @default(now())
}

enum EscrowStatus {
  HOLDING
  RELEASED
  FORFEITED
}

model PartyParticipant {
  id           String       @id @default(cuid())
  partyId      String
  party        Party        @relation(fields: [partyId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  depositWon   Int
  escrowStatus EscrowStatus @default(HOLDING)
  escrowTxRef  String? // 포트원 결제 트랜잭션 참조값 (mock)
  joinedAt     DateTime     @default(now())

  @@unique([partyId, userId])
}
